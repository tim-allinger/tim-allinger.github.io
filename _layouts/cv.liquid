---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title" style="font-size: 2.5em;">{{ page.title }}</h1>
  </header>

  {% if page.cv_pdf %}
    <p style="margin-top: 1rem;">
      You can view my CV below or
      <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" target="_blank">
        download it here
      </a>.
    </p>

    <div style="margin-top: 1.5rem;">
      <embed
        src="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
        type="application/pdf"
        width="100%"
        height="900px"
        style="border: 1px solid #ccc;"
      />
    </div>
  {% endif %}
</div>